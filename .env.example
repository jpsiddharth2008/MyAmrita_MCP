# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# MCP Protocol Version (Optional)
# =============================================================================
# NITRO_MCP_PROTOCOL_VERSION selects which MCP wire revision NitroStack speaks.
# Unset (default) defaults to 'auto' (serves 2026-07-28 stateless with legacy fallback).
#   - auto       : serve both eras from one process (default).
#   - 2026-07-28 : the new stateless spec (server/discover, per-request _meta,
#                  Mcp-Method/Mcp-Name headers, cache hints, MRTR, extensions).
#   - 2025-06-18 : the legacy 2025 sessionful spec.
# Your @Tool/@Resource/@Prompt/@Widget code is identical either way.
# =============================================================================
# NITRO_MCP_PROTOCOL_VERSION=auto

# Amrita Portal Session (Auth Module)
# =============================================================================
# SESSION_ENCRYPTION_KEY: a long random secret used to encrypt the locally
# persisted Amrita portal session cookies (.amrita-session.enc). Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required before calling the auth_login tool. Never commit the real value.
# =============================================================================
SESSION_ENCRYPTION_KEY=

# PLAYWRIGHT_BROWSERS_PATH=0 installs/loads the Chromium binary inside this
# project's node_modules instead of the global per-user cache. Some MCP client
# hosts (e.g. NitroStudio) run child processes in a context that can't see the
# global cache, causing "Executable doesn't exist" even though the file is
# genuinely present for other processes. Keeping the browser project-local
# avoids that entirely.
PLAYWRIGHT_BROWSERS_PATH=0
